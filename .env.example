# ==============================================================================
# Generic Multi-Tenant ERP - Environment Configuration
# ==============================================================================

# Django Core
SECRET_KEY=django-insecure-generic-erp-super-secret-key-production-grade
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
DB_NAME=generic_erp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# FastAPI Async Layer
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

